# Kopieer dit bestand naar .env en vul de echte waarden in.
# .env staat in .gitignore en wordt automatisch geladen door elk
# bunq-moneybird-commando (het bestand moet naast config.yaml staan).
# Al gezette omgevingsvariabelen winnen van dit bestand.

BUNQ_API_KEY_BEDRIJF_1=vul-hier-je-bunq-api-key-in
MONEYBIRD_TOKEN_BEDRIJF_1=vul-hier-je-moneybird-token-in

# BUNQ_API_KEY_BEDRIJF_2=...
# MONEYBIRD_TOKEN_BEDRIJF_2=...
